---
import '../styles/global.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-700.css';
import '@fontsource/manrope/latin-300.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import manrope300 from '@fontsource/manrope/files/manrope-latin-300-normal.woff2?url';
import dmSans400 from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
import Logo from '../components/Logo.astro';
import {personas} from '../data/personas';
interface Props { title:string; description?:string; privatePage?:boolean; hideQuoteButton?:boolean; }
const {title,description='Lavage et location de gobelets et de vaisselle pour vos événements. Collecte et livraison organisées en Haute-Savoie, Savoie et Ain.',privatePage=false,hideQuoteButton=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const path=Astro.url.pathname;
const internal=path.startsWith('/admin');
const nav=[{href:'/#solutions',label:'Prestations'},{href:'/prestations/location-vaisselle/',label:'Vaisselle'},{href:'/#pour-qui',label:'Pour qui ?'},{href:'/rse/',label:'Impact & RSE'},{href:'/blog/',label:'Guides'}];
const business={'@context':'https://schema.org','@type':'LocalBusiness',name:'La Plonge s’Adapte',description:'Entreprise adaptée : lavage et location de gobelets réutilisables et de vaisselle pour les événements.',url:'https://laplongesadapte.com/',telephone:'+33787896760',email:'accueil@laplongesadapte.com',logo:'https://laplongesadapte.com/brand/plonge/logo-vertical.svg',address:{'@type':'PostalAddress',postalCode:'74160',addressLocality:'Neydens',addressRegion:'Haute-Savoie',addressCountry:'FR'},areaServed:['Haute-Savoie','Savoie','Ain'].map(name=>({'@type':'AdministrativeArea',name})),slogan:'Fluide. Profonde. Adaptée.',knowsAbout:['Location de vaisselle','Lavage de gobelets réutilisables','Location de gobelets réutilisables','Réemploi','Entreprise adaptée'],hasOfferCatalog:{'@type':'OfferCatalog',name:'Prestations',itemListElement:[['Location de vaisselle','/prestations/location-vaisselle/'],['Lavage de gobelets','/prestations/lavage-gobelets/'],['Location de gobelets','/prestations/location-gobelets/']].map(([name,url])=>({'@type':'Offer',itemOffered:{'@type':'Service',name,url:`https://laplongesadapte.com${url}`}}))}};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title><meta name="description" content={description} />
    <meta name="robots" content={privatePage?'noindex, nofollow':'index, follow'} />
    {!privatePage && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={new URL('/brand/plonge/og.png',Astro.site)} /><meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={manrope300} as="font" type="font/woff2" crossorigin /><link rel="preload" href={dmSans400} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#041722" />
    <link rel="icon" href="/brand/plonge/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/plonge/apple-touch-icon.png" />
    {!privatePage && <script type="application/ld+json" set:html={JSON.stringify(business)} />}
  </head>
  <body class:list={[{'is-internal':internal,'no-sticky':hideQuoteButton||internal}]}>
    <a class="skip" href="#main">Aller au contenu</a>
    <div class="scroll-line" aria-hidden="true"><span></span></div>
    <header class="site-header" data-header>
      <a class="site-brand" href="/" aria-label="La Plonge s’Adapte — accueil"><Logo id="lg-head" /></a>
      <nav class="site-nav" aria-label="Navigation principale">
        {nav.map(n=><a href={n.href} aria-current={path===n.href?'page':undefined}>{n.label}</a>)}
      </nav>
      <div class="header-actions">
        <a class="header-phone" href="tel:+33787896760"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg><span>07 87 89 67 60</span></a>
        <a class="btn btn-primary btn-sm header-cta" href="/devis/">Préparer mon événement</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-panel" data-menu-toggle><span class="sr-only">Ouvrir le menu</span><i></i><i></i></button>
      </div>
    </header>
    <div class="menu-panel" id="menu-panel" data-menu hidden>
      <nav aria-label="Menu">
        <p class="label">Prestations</p>
        <a href="/prestations/lavage-gobelets/">Lavage de gobelets</a>
        <a href="/prestations/location-gobelets/">Location de gobelets</a>
        <a href="/prestations/location-vaisselle/">Location de vaisselle</a>
        <a href="/devis/?besoin=petits-lots">Petits événements & associations</a>
        <p class="label">Pour qui ?</p>
        {personas.map(p=><a href={`/pour/${p.slug}/`}>{p.nav}</a>)}
        <p class="label">Découvrir</p>
        <a href="/#methode">Notre méthode</a>
        <a href="/rse/">Impact & calculateur RSE</a>
        <a href="/entreprise-adaptee/oeth/">Entreprise adaptée & OETH</a>
        <a href="/blog/">Guides & conseils</a>
      </nav>
      <div class="menu-actions">
        <a class="btn btn-primary btn-lg" href="/devis/">Préparer mon événement <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost btn-lg" href="tel:+33787896760">Appeler le 07 87 89 67 60</a>
      </div>
    </div>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top">
        <div class="footer-brand"><Logo id="lg-foot" variant="vertical" /><p class="footer-motto">Fluide. Profonde. Adaptée.<br /><span>Les événements passent. Les bonnes habitudes restent.</span></p></div>
        <div class="footer-cols">
          <div><p class="label">Prestations</p><a href="/prestations/lavage-gobelets/">Lavage de gobelets</a><a href="/prestations/location-gobelets/">Location de gobelets</a><a href="/prestations/location-vaisselle/">Location de vaisselle</a><a href="/devis/?besoin=petits-lots">Petits événements & associations</a><a href="/devis/?besoin=conseil">Conseil à l’achat</a><a href="/devis/?besoin=stockage">Stockage de parc</a></div>
          <div><p class="label">Pour qui ?</p>{personas.map(p=><a href={`/pour/${p.slug}/`}>{p.nav}</a>)}</div>
          <div><p class="label">Ressources</p><a href="/rse/">Calculateur RSE</a><a href="/entreprise-adaptee/oeth/">Entreprise adaptée & OETH</a><a href="/blog/">Guides & conseils</a><a href="/confidentialite/">Vos données</a><a href="/admin/" rel="nofollow">Espace équipe</a></div>
          <div><p class="label">On en parle ?</p><a class="footer-big" href="tel:+33787896760">07 87 89 67 60</a><a href="mailto:accueil@laplongesadapte.com">accueil@laplongesadapte.com</a><address class="muted footer-address">La Plonge s’Adapte<br />74160 Neydens, Haute-Savoie, France<br />Interventions en Haute-Savoie, Savoie et Ain</address></div>
        </div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} La Plonge s’Adapte · Entreprise adaptée</span><a class="btn btn-primary btn-sm" href="/devis/">Préparer mon événement</a></div>
    </footer>
    {!hideQuoteButton && !internal && <div class="sticky-cta" data-sticky><a class="sticky-call" href="tel:+33787896760" aria-label="Appeler le 07 87 89 67 60"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg></a><a class="btn btn-primary sticky-main" href="/devis/">Préparer mon événement <span aria-hidden="true">→</span></a></div>}
    <script>
      const header=document.querySelector<HTMLElement>('[data-header]'),line=document.querySelector<HTMLElement>('.scroll-line span'),sticky=document.querySelector<HTMLElement>('[data-sticky]');
      let ticking=false;
      const onScroll=()=>{ticking=false;const y=scrollY,max=document.documentElement.scrollHeight-innerHeight;
        header?.toggleAttribute('data-scrolled',y>24);if(line)line.style.transform=`scaleX(${max>0?y/max:0})`;
        if(sticky){const nearEnd=y>max-260;sticky.toggleAttribute('data-visible',y>innerHeight*.7&&!nearEnd);}};
      addEventListener('scroll',()=>{if(!ticking){ticking=true;requestAnimationFrame(onScroll);}},{passive:true});onScroll();
      // Mobile menu
      const toggle=document.querySelector<HTMLButtonElement>('[data-menu-toggle]'),panel=document.querySelector<HTMLElement>('[data-menu]');
      const setMenu=(open:boolean)=>{if(!toggle||!panel)return;toggle.setAttribute('aria-expanded',String(open));toggle.querySelector('.sr-only')!.textContent=open?'Fermer le menu':'Ouvrir le menu';panel.hidden=!open;document.body.classList.toggle('menu-open',open);if(open)panel.querySelector<HTMLElement>('a')?.focus();};
      toggle?.addEventListener('click',()=>setMenu(toggle.getAttribute('aria-expanded')!=='true'));
      panel?.addEventListener('click',e=>{if((e.target as HTMLElement).closest('a'))setMenu(false);});
      addEventListener('keydown',e=>{if(e.key==='Escape'&&toggle?.getAttribute('aria-expanded')==='true'){setMenu(false);toggle.focus();}});
      // Reveal on scroll
      const items=document.querySelectorAll<HTMLElement>('[data-reveal]');
      if(matchMedia('(prefers-reduced-motion: reduce)').matches||!('IntersectionObserver' in window))items.forEach(el=>el.classList.add('is-in'));
      else{const io=new IntersectionObserver(entries=>entries.forEach(en=>{if(en.isIntersecting){en.target.classList.add('is-in');io.unobserve(en.target);}}),{rootMargin:'0px 0px -8% 0px',threshold:.12});items.forEach(el=>io.observe(el));}
    </script>
  </body>
</html>
