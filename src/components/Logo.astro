---
// Inline vector logo (generated by scripts/create-logo-plonge.py). Inline so it can glow and animate.
import paths from '../lib/logo-paths.json';
interface Props { variant?:'horizontal'|'mark'|'vertical'; id:string; class?:string; title?:string }
const {variant='horizontal',id,class:className='',title='La Plonge s’Adapte'}=Astro.props;
const a=`${id}-a`,b=`${id}-b`,w=`${id}-w`;
const mk=.25,tx=1035*mk+26,hw=tx+paths.topWidth*.62+4,vw=Math.max(paths.topWidth,1035*.62)+40;
const box=variant==='mark'?'0 0 1035 480':variant==='vertical'?`0 0 ${vw} 530`:`0 0 ${hw} ${480*mk}`;
---
<svg class={`logo logo-${variant} ${className}`} viewBox={box} role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id={a} x1="40" y1="440" x2="708" y2="40" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#7f97a3"/><stop offset=".42" stop-color="#e4edf1"/><stop offset=".62" stop-color="#fff"/><stop offset="1" stop-color="#b9cad2"/></linearGradient>
    <linearGradient id={b} x1="340" y1="330" x2="1000" y2="92" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#a9bcc5"/><stop offset=".38" stop-color="#fff"/><stop offset=".7" stop-color="#c3d4db"/><stop offset="1" stop-color="#6f93a3"/></linearGradient>
    <linearGradient id={w} x1="0" y1="0" x2="0" y2="100" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#fff"/><stop offset=".55" stop-color="#e3ecf0"/><stop offset="1" stop-color="#aebfc7"/></linearGradient>
  </defs>
  {variant==='mark'&&<g class="logo-mark"><path class="ribbon-a" d={paths.ribbonA} fill={`url(#${a})`}/><path class="ribbon-b" d={paths.ribbonB} fill={`url(#${b})`}/></g>}
  {variant==='horizontal'&&<>
    <g class="logo-mark" transform={`scale(${mk})`}><path class="ribbon-a" d={paths.ribbonA} fill={`url(#${a})`}/><path class="ribbon-b" d={paths.ribbonB} fill={`url(#${b})`}/></g>
    <g transform={`translate(${tx} 4) scale(.62)`} fill="none" stroke={`url(#${w})`} stroke-width="7" stroke-linecap="square" set:html={paths.top} />
    <g transform={`translate(${tx+2} 90) scale(.235)`} fill="none" stroke="#72c6d4" stroke-width="15" stroke-linecap="square" set:html={paths.sub} />
  </>}
  {variant==='vertical'&&<>
    <g class="logo-mark" transform={`translate(${(vw-1035*.62)/2} 0) scale(.62)`}><path class="ribbon-a" d={paths.ribbonA} fill={`url(#${a})`}/><path class="ribbon-b" d={paths.ribbonB} fill={`url(#${b})`}/></g>
    <g transform={`translate(${(vw-paths.topWidth)/2} 340)`} fill="none" stroke={`url(#${w})`} stroke-width="6" stroke-linecap="square" set:html={paths.top} />
    <g transform={`translate(${(vw-paths.subWidth*.36)/2} 474) scale(.36)`} fill="none" stroke="#72c6d4" stroke-width="11" stroke-linecap="square" set:html={paths.sub} />
  </>}
</svg>
