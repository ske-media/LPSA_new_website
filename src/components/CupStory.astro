---
// Act 2 — the cinematic Blender sequence (pyramid → collapse → tidy stacks), driven by scroll.
import type {Lang} from '../i18n';
interface Props{lang?:Lang}
const {lang='fr'}=Astro.props;
const T={
  fr:{aria:'Du séchage improvisé à une prise en charge organisée',scene:'La pyramide du lendemain',labels:['La pyramide du lendemain','Le passage de relais','Le relais est pris'],
    c:[['01 · Le lendemain de la fête','Vos équipes ont tout donné.','Leur soirée ne devrait pas finir ici.','Des gobelets et de la vaisselle à laver. Des tables occupées. Un séchage qui s’éternise. Une seule pile qui bascule, et tout recommence.'],
       ['02 · Le passage de relais','Ce qui vous reste sur les bras,','c’est notre métier.','Collecte si vous le souhaitez, lavage, séchage, comptage et conditionnement : nous organisons toute la prise en charge.'],
       ['03 · La suite est prête','Votre prochain événement.','Pas votre prochaine corvée.','Votre parc revient propre, compté et conditionné, selon le calendrier convenu.']],
    method:'Découvrir notre méthode',cta:'Préparer mon événement',quote:'/devis/',territory:'Haute-Savoie · Savoie · Ain'},
  en:{aria:'From makeshift drying to a well-run service',scene:'The morning-after pyramid',labels:['The morning-after pyramid','Handing over','We take it from here'],
    c:[['01 · The morning after','Your team gave it everything.','Their evening should not end here.','Cups and tableware to wash. Tables taken up. Drying that drags on. One stack tips over, and it all starts again.'],
       ['02 · Handing over','What is left on your hands','is our job.','Collection if you wish, washing, drying, counting and packing: we organise the whole service.'],
       ['03 · Ready for what’s next','Your next event.','Not your next chore.','Your cups come back clean, counted and packed, on the agreed schedule.']],
    method:'See how we work',cta:'Plan my event',quote:'/en/devis/',territory:'Haute-Savoie · Savoie · Ain · near Geneva'},
}[lang];
---
<section class="scroll-story" id="cup-story" aria-label={T.aria} data-labels={JSON.stringify(T.labels)}>
  <div class="story-stage">
    <div class="cinematic-visual" aria-hidden="true"><picture><source media="(max-width:700px)" srcset="/cinematic-hq/mobile/000.webp"/><img src="/cinematic-hq/desktop/000.webp" alt="" loading="lazy" width="2560" height="1600" /></picture><canvas id="cinematic-canvas"></canvas></div>
    <div class="story-shade" aria-hidden="true"></div>
    <div class="scene-footer" aria-hidden="true"><span id="scene-label">{T.scene}</span><div class="scene-progress"><span></span></div><span class="scene-counter" id="scene-counter">01 / 03</span></div>
  </div>
  <div class="story-narrative">
    {T.c.map(([label,h,em,lead],i)=><div class="story-chapter"><div class="story-copy"><p class="label">{label}</p><h2>{h} <em>{em}</em></h2><p class="lead">{lead}</p>
      {i===1&&<a class="text-link" href="#methode">{T.method} <span aria-hidden="true">→</span></a>}
      {i===2&&<><div class="cta-row"><a class="btn btn-primary" href={T.quote}>{T.cta} <span aria-hidden="true">→</span></a></div><p class="territory">{T.territory}</p></>}
    </div></div>)}
  </div>
</section>
<script>
 import {mountCinematic} from '../lib/cinematic';
 const root=document.getElementById('cup-story');
 if(root) mountCinematic(root);
</script>
