---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import CupStory from '../components/CupStory.astro';
import ParkEstimator from '../components/ParkEstimator';
import PartnerAugust from '../components/PartnerAugust.astro';
import vaisselle from '../data/vaisselle-august.json';
import vaisselleEn from '../data/vaisselle-august-en.json';
import {personas} from '../data/personas';
import {personasEn} from '../data/personas-en';
import {editorialPosts} from '../lib/editorial';
import {editorialPostsEn} from '../lib/editorial-en';
import {homeText} from './home-text';
import type {Lang} from '../i18n';
interface Props{lang:Lang}
const {lang}=Astro.props;
const en=lang==='en',L=(p:string)=>en&&p.startsWith('/')?`/en${p}`:p;
const T=homeText[lang];
const featured=['lavage-gobelets-festival','combien-gobelets-prevoir-evenement','gobelets-marche-noel-vin-chaud'].map(slug=>(en?editorialPostsEn:editorialPosts).find(p=>p.slug===slug)!);
const P=en?personasEn:personas;
const itemName=(i:typeof vaisselle[number])=>en?((vaisselleEn.names as Record<string,string>)[String(i.id)]??i.name):i.name;
const num=(n:number)=>n.toLocaleString(en?'en-GB':'fr-FR');
const icons={
  lavage:'<path d="M12 3c3 4 5 6.5 5 9a5 5 0 0 1-10 0c0-2.5 2-5 5-9z"/><path d="M9.5 13.5a2.5 2.5 0 0 0 2.5 2.5"/>',
  gobelets:'<path d="M6 4h12l-1.6 15.2a1 1 0 0 1-1 .8H8.6a1 1 0 0 1-1-.8z"/><path d="M6.6 9h10.8"/>',
  vaisselle:'<circle cx="12" cy="12" r="6.5"/><circle cx="12" cy="12" r="3"/><path d="M3 4v6a1.5 1.5 0 0 0 1.5 1.5V20M21 4c-1.5 1-2 3-2 5s.8 2.5 2 2.5V20"/>',
  petits:'<circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><path d="M2.5 20a5.5 5.5 0 0 1 11 0M10.5 20a5.5 5.5 0 0 1 11 0"/>',
};
const faqLd={'@context':'https://schema.org','@type':'FAQPage',mainEntity:T.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title={T.title} description={T.description} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <!-- Act 1 · La plongée -->
  <section class="dive" id="plongee" data-dive aria-label="La Plonge s’Adapte">
    <div class="dive-stage">
      <canvas class="dive-canvas" aria-hidden="true"></canvas>
      <div class="dive-poster" aria-hidden="true"><Logo id="lg-hero" variant="mark" /></div>
      <div class="dive-copy dive-copy-1">
        <p class="label">{T.hero.label}</p>
        <h1>{T.hero.h1[0]} <em>{T.hero.h1[1]}</em></h1>
        <p class="lead">{T.hero.lead}</p>
        <div class="cta-row"><a class="btn btn-primary btn-lg" href={L('/devis/')}>{T.hero.cta} <span aria-hidden="true">→</span></a><a class="btn btn-ghost btn-lg" href="#solutions">{T.hero.cta2}</a></div>
      </div>
      <div class="dive-copy dive-copy-2">
        <p class="label">{T.dive2.label}</p>
        <h2>{T.dive2.h2[0]} <em>{T.dive2.h2[1]}</em></h2>
        <p class="lead">{T.dive2.lead}</p>
      </div>
      <div class="depth" aria-hidden="true"><span class="depth-value">0 m</span><div class="depth-track"><i></i></div><span class="depth-label">{T.depth}</span></div>
      <a class="dive-cue" href="#cup-story"><span>{T.cue}</span><i aria-hidden="true"></i></a>
    </div>
  </section>

  <!-- Act 2 · Le lendemain -->
  <CupStory lang={lang} />

  <!-- Repères -->
  <section class="stats wrap" aria-label={T.statsLabel}>
    {T.stats.map((s,i)=><div class="stat" data-reveal style={`--d:${i*.08}s`}><p class="stat-value"><span data-count={s.v}>{num(s.v)}</span></p><p class="stat-unit">{s.unit}</p><p class="stat-text">{s.text}</p></div>)}
  </section>

  <!-- Pour qui -->
  <section id="pour-qui" class="section who">
    <div class="section-head" data-reveal><div><p class="label">{T.who.label}</p><h2>{T.who.h2[0]} <em>{T.who.h2[1]}</em></h2></div><p>{T.who.p}</p></div>
    <div class="who-grid">{P.map((p,i)=><a class="card who-card" href={L(`/pour/${p.slug}/`)} data-reveal data-spot style={`--d:${i*.06}s`}><span class="solution-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={p.icon} /></span><h3>{p.nav}</h3><p>{p.teaser}</p><span class="card-cta">{T.who.cta} <span aria-hidden="true">→</span></span></a>)}</div>
  </section>

  <!-- Méthode -->
  <section id="methode" class="section method" data-method>
    <div class="method-head" data-reveal>
      <p class="label">{T.method.label}</p>
      <h2>{T.method.h2[0]} <em>{T.method.h2[1]}</em></h2>
      <p class="lead">{T.method.lead}</p>
      <a class="btn btn-ghost" href={L('/devis/')}>{T.method.cta} <span aria-hidden="true">→</span></a>
    </div>
    <ol class="method-steps">
      <i class="method-line" aria-hidden="true"><b></b></i>
      {T.steps.map((s,i)=><li data-reveal style={`--d:${i*.1}s`}><span class="method-n">{s.n}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>)}
    </ol>
  </section>

  <!-- Prestations -->
  <section id="solutions" class="section solutions">
    <div class="section-head" data-reveal><div><p class="label">{T.sol.label}</p><h2>{T.sol.h2[0]} <em>{T.sol.h2[1]}</em></h2></div><p>{T.sol.p}</p></div>
    <div class="cards solution-grid">
      {T.solutions.map((s,i)=><a class="card solution" href={s.href} data-reveal data-spot style={`--d:${i*.1}s`}>
        <span class="solution-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.key as keyof typeof icons]} /></span>
        <span class="card-number">{s.n}</span>
        <h3>{s.title}</h3><p class="solution-lead">{s.lead}</p><p>{s.text}</p>
        <ul>{s.points.map(p=><li>{p}</li>)}</ul>
        <span class="card-cta">{s.cta} <span aria-hidden="true">→</span></span>
      </a>)}
    </div>
    <div class="solutions-more" data-reveal><p>{T.sol.more[0]}<strong>{T.sol.more[1]}</strong>{T.sol.more[2]}<strong>{T.sol.more[3]}</strong>{T.sol.more[4]}</p><div class="cta-row"><a class="btn btn-ghost btn-sm" href={L('/devis/?besoin=conseil')}>{T.sol.buy}</a><a class="btn btn-ghost btn-sm" href={L('/devis/?besoin=stockage')}>{T.sol.store}</a></div></div>
  </section>

  <!-- Réceptions -->
  <section class="receptions" aria-label={T.rec.aria}>
    <div class="wrap receptions-inner">
      <div class="receptions-text" data-reveal>
        <p class="label">{T.rec.label}</p>
        <h2>{T.rec.h2[0]} <em>{T.rec.h2[1]}</em></h2>
        <p class="lead">{T.rec.lead}</p>
        <div class="cta-row"><a class="btn btn-primary btn-lg" href={L('/prestations/location-vaisselle/')}>{T.rec.cta} <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="receptions-mosaic" data-reveal style="--d:.1s">{[2,38,60,96,118,148].map((k,i)=><img src={vaisselle[k%vaisselle.length].image} alt={`${itemName(vaisselle[k%vaisselle.length])} ${T.rec.alt}`} width="420" height="420" loading="lazy" style={`--i:${i}`} />)}</div>
    </div>
    <div class="wrap"><PartnerAugust id="pa-home" compact lang={lang} /></div>
  </section>

  <!-- Estimateur -->
  <section id="estimer" class="section estimate">
    <div class="section-head" data-reveal><div><p class="label">{T.est.label}</p><h2>{T.est.h2[0]} <em>{T.est.h2[1]}</em></h2></div><p>{T.est.p}</p></div>
    <div data-reveal><ParkEstimator client:visible lang={lang} /></div>
  </section>

  <!-- Engagement -->
  <section class="engage">
    <div class="engage-glow" aria-hidden="true"><Logo id="lg-engage" variant="mark" /></div>
    <div class="wrap engage-inner">
      <div data-reveal><p class="label">{T.eng.label}</p><h2>{T.eng.h2[0]} <em>{T.eng.h2[1]}</em></h2></div>
      <div class="engage-text" data-reveal style="--d:.1s">
        <p class="lead">{T.eng.lead}</p>
        <p>{T.eng.p}</p>
        <div class="engage-links">
          <a class="card engage-card" href={L('/rse/')} data-spot><span class="label plain">{T.eng.c1[0]}</span><strong>{T.eng.c1[1]}</strong><span class="card-cta">{T.eng.c1[2]} <span aria-hidden="true">→</span></span></a>
          <a class="card engage-card" href={L('/entreprise-adaptee/oeth/')} data-spot><span class="label plain">{T.eng.c2[0]}</span><strong>{T.eng.c2[1]}</strong><span class="card-cta">{T.eng.c2[2]} <span aria-hidden="true">→</span></span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Guides -->
  <section class="section guides">
    <div class="section-head" data-reveal><div><p class="label">{T.guides.label}</p><h2>{T.guides.h2[0]} <em>{T.guides.h2[1]}</em></h2></div><a class="text-link" href={L('/blog/')}>{T.guides.all} <span aria-hidden="true">→</span></a></div>
    <div class="cards guide-row">
      {featured.map((p,i)=><a class="card guide" href={L(`/blog/${p.slug}/`)} data-reveal data-spot style={`--d:${i*.1}s`}><span class="chip">{p.category}</span><h3>{p.title}</h3><p>{p.excerpt}</p><span class="card-cta">{T.guides.read} <span aria-hidden="true">→</span></span></a>)}
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq">
    <div class="faq-head" data-reveal><p class="label">{T.faqHead.label}</p><h2>{T.faqHead.h2[0]} <em>{T.faqHead.h2[1]}</em></h2><p class="lead">{T.faqHead.lead} <a class="text-link" href="tel:+33787896760">{T.faqHead.phone}</a>.</p></div>
    <div class="faq-list">{T.faq.map((f,i)=><details data-reveal style={`--d:${i*.05}s`}><summary><span>{f.q}</span><i aria-hidden="true"></i></summary><p>{f.a}</p></details>)}</div>
  </section>

  <!-- Final -->
  <section class="final">
    <div class="final-mark" aria-hidden="true"><Logo id="lg-final" variant="mark" /></div>
    <div class="final-inner" data-reveal>
      <p class="label plain">{T.fin.label}</p>
      <h2>{T.fin.h2[0]} <em>{T.fin.h2[1]}</em></h2>
      <p class="lead">{T.fin.lead}</p>
      <div class="cta-row"><a class="btn btn-primary btn-lg" href={L('/devis/')}>{T.fin.cta} <span aria-hidden="true">→</span></a><a class="btn btn-ghost btn-lg" href="tel:+33787896760">{T.fin.phone}</a></div>
    </div>
  </section>
</Layout>
<script>
  const root=document.querySelector<HTMLElement>('[data-dive]');
  const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Depth gauge and copy follow scroll even before (or without) WebGL.
  if(root){
    const value=root.querySelector('.depth-value');
    const onScroll=()=>{const r=root.getBoundingClientRect(),p=Math.max(0,Math.min(1,-r.top/Math.max(1,r.height-innerHeight)));root.style.setProperty('--p',p.toFixed(4));if(value)value.textContent=`${Math.round(p*40)} m`;};
    addEventListener('scroll',onScroll,{passive:true});onScroll();
    if(reduced)root.dataset.scene='static';
    else{
      const load=()=>import('../lib/dive-scene').then(m=>m.mountDive(root)).catch(()=>{root.dataset.scene='static';});
      const events=['pointermove','pointerdown','touchstart','scroll','keydown'] as const;
      const start=()=>{events.forEach(e=>removeEventListener(e,start));load();};
      events.forEach(e=>addEventListener(e,start,{passive:true,once:true}));
    }
  }
  // Method line follows scroll
  const method=document.querySelector<HTMLElement>('[data-method]');
  if(method){const upd=()=>{const r=method.getBoundingClientRect(),p=Math.max(0,Math.min(1,(innerHeight*.7-r.top)/r.height));method.style.setProperty('--m',p.toFixed(3));};addEventListener('scroll',upd,{passive:true});upd();}
  // Spotlight on cards
  document.querySelectorAll<HTMLElement>('[data-spot]').forEach(el=>el.addEventListener('pointermove',e=>{const r=el.getBoundingClientRect();el.style.setProperty('--mx',`${e.clientX-r.left}px`);el.style.setProperty('--my',`${e.clientY-r.top}px`);}));
  // Count-up
  const counters=document.querySelectorAll<HTMLElement>('[data-count]');
  if(!reduced&&'IntersectionObserver' in window){
    const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;io.unobserve(e.target);const el=e.target as HTMLElement,end=Number(el.dataset.count),t0=performance.now();
      const tick=(t:number)=>{const k=Math.min(1,(t-t0)/1400),v=Math.round(end*(1-Math.pow(1-k,3)));el.textContent=v.toLocaleString(document.documentElement.lang==='en'?'en-GB':'fr-FR');if(k<1)requestAnimationFrame(tick);};requestAnimationFrame(tick);}),{threshold:.6});
    counters.forEach(c=>io.observe(c));
  }
</script>
