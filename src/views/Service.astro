---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import {editorialPosts} from '../lib/editorial';
import {editorialPostsEn} from '../lib/editorial-en';
import {personas} from '../data/personas';
import {personasEn} from '../data/personas-en';
import {serviceText,type ServiceSlug} from './service-text';
import type {Lang} from '../i18n';
interface Props{lang:Lang;service:ServiceSlug}
const {lang,service}=Astro.props;
const en=lang==='en',L=(p:string)=>en&&p.startsWith('/')?`/en${p}`:p;
const T=serviceText[lang];
const {title,headline,intro,need,related}=T.entries[service];
const posts:{slug:string;title:string;category:string}[]=en?editorialPostsEn:editorialPosts;
const guides=related.map(slug=>posts.find(p=>p.slug===slug)!);
const m=T.meta[need];
const faqPage={'@context':'https://schema.org','@type':'FAQPage',mainEntity:m.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
const audiences=m.audiences.map(slug=>(en?personasEn:personas).find(x=>x.slug===slug)!);
const faqLd={'@context':'https://schema.org','@type':'Service',name:title,provider:{'@type':'LocalBusiness',name:'La Plonge s’Adapte',telephone:'+33787896760'},areaServed:['Haute-Savoie','Savoie','Ain'],description:intro,...(en?{url:`https://laplongesadapte.com/en/prestations/${service}/`,inLanguage:'en'}:{})};
---
<Layout title={m.title} description={m.description} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqPage)} />
  <section class="page-hero">
    <div class="hero-mark" aria-hidden="true"><Logo id="lg-svc" variant="mark" /></div>
    <p class="crumb"><a href={L('/')}>{T.home}</a> / <a href={L('/#solutions')}>{T.services}</a> / <span>{title}</span></p>
    <p class="label">{title} · Haute-Savoie · Savoie · Ain</p>
    <h1>{headline}</h1>
    <p class="lead">{intro}</p>
    <div class="cta-row"><a class="btn btn-primary btn-lg" href={L(`/devis/?besoin=${need}`)}>{T.quote} <span aria-hidden="true">→</span></a><a class="btn btn-ghost btn-lg" href="tel:+33787896760">{T.phone}</a></div>
  </section>
  <section class="section split">
    <div data-reveal><p class="label">{T.how.label}</p><h2>{T.how.h2[0]} <em>{T.how.h2[1]}</em></h2><p class="lead" style="margin-top:22px">{T.how.lead}</p><p class="small-lots-note">{T.how.small}<a class="text-link" href={L('/devis/?besoin=petits-lots')}>{T.how.smallLink} <span aria-hidden="true">→</span></a></p></div>
    <ol class="feature-list">{T.steps[need].map(([h,t],i)=><li data-reveal style={`--d:${i*.08}s`}><b>{String(i+1).padStart(2,'0')}</b><div><h3>{h}</h3><p>{t}</p></div></li>)}</ol>
  </section>
  <section class="section" style="padding-top:0">
    <div class="section-head" data-reveal><div><p class="label">{T.includes.label}</p><h2>{title}, <em>{T.includes.em}</em></h2></div></div>
    <ul class="arg-grid">{m.includes.map(([h,t],i)=><li data-reveal style={`--d:${(i%3)*.08}s`}><span class="arg-check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><h3>{h}</h3><p>{t}</p></li>)}</ul>
  </section>
  <section class="section" style="padding-top:0"><p class="label">{T.forYou}</p><div class="persona-chips">{audiences.map(o=><a href={L(`/pour/${o.slug}/`)}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={o.icon} />{o.nav}</a>)}<a href={L('/prestations/location-vaisselle/')}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="6.5"/><circle cx="12" cy="12" r="3"/></svg>{T.vaisselle}</a></div></section>
  <section class="section faq" style="padding-top:0">
    <div class="faq-head" data-reveal><p class="label">{T.faqHead.label}</p><h2>{T.faqHead.h2[0]} <em>{T.faqHead.h2[1]}</em></h2><p class="lead">{T.faqHead.lead}<a class="text-link" href="tel:+33787896760">{T.phone}</a></p></div>
    <div class="faq-list">{m.faq.map((f,i)=><details data-reveal style={`--d:${i*.05}s`}><summary><span>{f.q}</span><i aria-hidden="true"></i></summary><p>{f.a}</p></details>)}</div>
  </section>
  <section class="section" style="padding-top:0"><div class="band-cta" data-reveal><h2>{T.band[0]} <em>{T.band[1]}</em></h2><div class="cta-row"><a class="btn btn-primary btn-lg" href={L(`/devis/?besoin=${need}`)}>{T.quote} <span aria-hidden="true">→</span></a></div></div></section>
  <section class="section related-guides" style="padding-top:0"><p class="label">{T.guides.label}</p><div class="cards">{guides.map((p,i)=><a class="card" href={L(`/blog/${p.slug}/`)} data-reveal style={`--d:${i*.08}s`}><span class="chip">{p.category}</span><h3>{p.title}</h3><span class="card-cta">{T.guides.read} <span aria-hidden="true">→</span></span></a>)}</div></section>
</Layout>
