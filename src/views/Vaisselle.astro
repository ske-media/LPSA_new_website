---
import Layout from '../layouts/Layout.astro';
import PartnerAugust from '../components/PartnerAugust.astro';
import VaisselleCatalog from '../components/VaisselleCatalog';
import items from '../data/vaisselle-august.json';
import itemsEn from '../data/vaisselle-august-en.json';
import {editorialPosts} from '../lib/editorial';
import {editorialPostsEn} from '../lib/editorial-en';
import {vaisselleText} from './vaisselle-text';
import type {Lang} from '../i18n';
interface Props{lang:Lang}
const {lang}=Astro.props;
const en=lang==='en',L=(p:string)=>en&&p.startsWith('/')?`/en${p}`:p;
const T=vaisselleText[lang];
const posts:{slug:string;title:string;category:string}[]=en?editorialPostsEn:editorialPosts;
const guides=['location-vaisselle-evenement-guide','collecte-livraison-gobelets-evenement','rse-gobelets-reemploi-indicateurs'].map(slug=>posts.find(p=>p.slug===slug)!);
const itemName=(i:typeof items[number])=>en?((itemsEn.names as Record<string,string>)[String(i.id)]??i.name):i.name;
const mosaic=[3,40,75,100,120,150].map(i=>items[i%items.length]);
const faq=T.faq;
const ld={'@context':'https://schema.org','@type':'Service',name:T.ld.name,serviceType:T.ld.serviceType,provider:{'@type':'LocalBusiness',name:'La Plonge s’Adapte',telephone:'+33787896760'},areaServed:['Haute-Savoie','Savoie','Ain'],description:T.ld.description,...(en?{url:'https://laplongesadapte.com/en/prestations/location-vaisselle/',inLanguage:'en'}:{})};
---
<Layout title={T.title} description={T.description} hideQuoteButton lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))})} />
  <section class="page-hero vaisselle-hero">
    <div class="vaisselle-mosaic">{mosaic.map((m,i)=><img src={m.image} alt={`${itemName(m)} ${T.alt}`} width="420" height="420" style={`--i:${i}`} loading={i<3?'eager':'lazy'} />)}</div>
    <p class="crumb"><a href={L('/')}>{T.home}</a> / <a href={L('/#solutions')}>{T.services}</a> / <span>{T.crumb}</span></p>
    <p class="label">{T.hero.label}</p>
    <h1>{T.hero.h1[0]} <em>{T.hero.h1[1]}</em></h1>
    <p class="lead">{T.hero.lead}</p>
    <div class="cta-row"><a class="btn btn-primary btn-lg" href="#catalogue">{T.hero.cta} <span aria-hidden="true">→</span></a><a class="btn btn-ghost btn-lg" href={L('/devis/?besoin=vaisselle')}>{T.hero.cta2}</a></div>
    <ul class="hero-facts"><li><strong>{items.length}</strong> {T.hero.facts[0]}</li><li><strong>0</strong> {T.hero.facts[1]}</li><li><strong>1</strong> {T.hero.facts[2]}</li></ul>
  </section>

  <section class="section occasions">
    <div class="section-head" data-reveal><div><p class="label">{T.occ.label}</p><h2>{T.occ.h2[0]} <em>{T.occ.h2[1]}</em></h2></div><p>{T.occ.p}</p></div>
    <div class="occasion-grid">{T.occasions.map((o,i)=><a class="card occasion" href={o.href||L('/devis/?besoin=vaisselle')} data-reveal data-spot style={`--d:${(i%3)*.08}s`}><span class="solution-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={o.icon} /></span><h3>{o.title}</h3><p>{o.text}</p><span class="card-cta">{T.occ.cta} <span aria-hidden="true">→</span></span></a>)}</div>
  </section>

  <section class="section split service-all">
    <div data-reveal><p class="label">{T.all.label}</p><h2>{T.all.h2[0]} <em>{T.all.h2[1]}</em></h2><p class="lead" style="margin-top:22px">{T.all.lead}</p><div class="cta-row"><a class="btn btn-primary" href={L('/devis/?besoin=vaisselle')}>{T.all.cta} <span aria-hidden="true">→</span></a></div></div>
    <ol class="feature-list">{T.steps.map(([h,t],i)=><li data-reveal style={`--d:${i*.06}s`}><b>{String(i+1).padStart(2,'0')}</b><div><h3>{h}</h3><p>{t}</p></div></li>)}</ol>
  </section>

  <div class="wrap"><PartnerAugust id="pa-page" lang={lang} /></div>

  <section class="section catalog-section" id="catalogue">
    <div class="section-head" data-reveal><div><p class="label">{T.cat.label}</p><h2>{T.cat.h2[0]} <em>{T.cat.h2[1]}</em></h2></div><p>{T.cat.p}</p></div>
    <VaisselleCatalog client:visible lang={lang} />
  </section>

  <section class="section faq">
    <div class="faq-head" data-reveal><p class="label">{T.faqHead.label}</p><h2>{T.faqHead.h2[0]} <em>{T.faqHead.h2[1]}</em></h2><p class="lead">{T.faqHead.lead}<a class="text-link" href="tel:+33787896760">{T.phone}</a></p></div>
    <div class="faq-list">{faq.map((f,i)=><details data-reveal style={`--d:${i*.05}s`}><summary><span>{f.q}</span><i aria-hidden="true"></i></summary><p>{f.a}</p></details>)}</div>
  </section>

  <section class="section" style="padding-top:0"><div class="band-cta" data-reveal><h2>{T.band.h2[0]} <em>{T.band.h2[1]}</em></h2><div class="cta-row"><a class="btn btn-primary btn-lg" href={L('/devis/?besoin=vaisselle')}>{T.band.cta} <span aria-hidden="true">→</span></a><a class="btn btn-ghost btn-lg" href="tel:+33787896760">{T.phone}</a></div></div></section>

  <section class="section related-guides" style="padding-top:0"><p class="label">{T.guides.label}</p><div class="cards">{guides.map((p,i)=><a class="card" href={L(`/blog/${p.slug}/`)} data-reveal style={`--d:${i*.08}s`}><span class="chip">{p.category}</span><h3>{p.title}</h3><span class="card-cta">{T.guides.read} <span aria-hidden="true">→</span></span></a>)}</div></section>
</Layout>
<script>
  document.querySelectorAll<HTMLElement>('[data-spot]').forEach(el=>el.addEventListener('pointermove',e=>{const r=el.getBoundingClientRect();el.style.setProperty('--mx',`${e.clientX-r.left}px`);el.style.setProperty('--my',`${e.clientY-r.top}px`);}));
</script>
