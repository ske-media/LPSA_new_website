---
// One guide: breadcrumb, table of contents, article, FAQ data, topic call to action, related guides.
import Layout from '../layouts/Layout.astro';
import {renderArticle,catByName,readingMinutes,dateFmt} from '../lib/blog-structure';
import type {Lang} from '../i18n';
type Item={slug:string;title:string;excerpt:string;category:string;published_at:string|null;updated_at:string;content_markdown:string;seo_title?:string;seo_description?:string;author_name:string;cover_url?:string;cover_alt?:string};
interface Props{lang:Lang;post:Item;related:Item[];alternate?:string|null}
const {lang,post,related,alternate}=Astro.props;
const en=lang==='en',base=en?'/en/blog':'/blog';
const T={
  fr:{home:'Accueil',blog:'Guides',toc:'Sommaire',min:'min de lecture',updated:'Mis à jour le',by:'Par',about:'À propos',aboutText:'La Plonge s’Adapte est une entreprise adaptée installée à Neydens, en Haute-Savoie. Notre équipe loue et lave gobelets réutilisables et vaisselle pour les événements de Haute-Savoie, de Savoie et de l’Ain.',aboutLink:'Découvrir nos prestations',related:'À lire aussi',read:'Lire le guide',more:'Tous les guides',quote:'Demander un devis',phone:'07 87 89 67 60',ctaLabel:'Passons à l’action',share:'Partager'},
  en:{home:'Home',blog:'Guides',toc:'Contents',min:'min read',updated:'Updated',by:'By',about:'About us',aboutText:'La Plonge s’Adapte is a disability-inclusive company (entreprise adaptée) in Neydens, Haute-Savoie, near Geneva. Our team rents out and washes reusable cups and tableware for events in Haute-Savoie, Savoie and Ain.',aboutLink:'Discover our services',related:'Read next',read:'Read the guide',more:'All guides',quote:'Request a quote',phone:'+33 7 87 89 67 60',ctaLabel:'Ready when you are',share:'Share'},
}[lang];
const cat=catByName(post.category);
const {html,toc,faq}=renderArticle(post.content_markdown);
const url=`https://laplongesadapte.com${base}/${post.slug}/`;
const minutes=readingMinutes(post.content_markdown);
const cta=cat.cta[lang];
const ld=[
  {'@context':'https://schema.org','@type':'BlogPosting',headline:post.title,description:post.seo_description||post.excerpt,inLanguage:lang,articleSection:cat[lang],wordCount:post.content_markdown.split(/\s+/).length,datePublished:post.published_at,dateModified:post.updated_at,author:{'@type':'Organization',name:'La Plonge s’Adapte',url:'https://laplongesadapte.com/'},publisher:{'@type':'Organization',name:'La Plonge s’Adapte',logo:{'@type':'ImageObject',url:'https://laplongesadapte.com/brand/plonge/og.png'}},image:post.cover_url||'https://laplongesadapte.com/brand/plonge/og.png',mainEntityOfPage:url},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[[T.home,en?'/en/':'/'],[T.blog,`${base}/`],[cat.title[lang],`${base}/categorie/${cat.slug}/`],[post.title,`${base}/${post.slug}/`]].map(([name,u],i)=>({'@type':'ListItem',position:i+1,name,item:`https://laplongesadapte.com${u}`}))},
  ...(faq.length?[{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}]:[]),
];
const updated=post.updated_at&&post.published_at&&post.updated_at.slice(0,10)>post.published_at.slice(0,10);
---
<Layout title={post.seo_title||post.title} description={post.seo_description||post.excerpt} lang={lang} alternate={alternate} switchFallback={en?'/blog/':'/en/blog/'}>
  {ld.map(x=><script type="application/ld+json" set:html={JSON.stringify(x).replace(/</g,'\\u003c')} />)}
  <div class="article-shell">
    <article class="blog-article">
      <p class="crumb"><a href={en?'/en/':'/'}>{T.home}</a> / <a href={`${base}/`}>{T.blog}</a> / <a href={`${base}/categorie/${cat.slug}/`}>{cat.title[lang]}</a></p>
      <h1>{post.title}</h1>
      <p class="article-excerpt">{post.excerpt}</p>
      <p class="article-meta">{T.by} {post.author_name} · {post.published_at&&<time datetime={post.published_at}>{dateFmt(post.published_at,lang)}</time>}{updated&&<> · {T.updated} <time datetime={post.updated_at}>{dateFmt(post.updated_at,lang)}</time></>} · {minutes} {T.min}</p>
      {post.cover_url&&<img class="article-cover" src={post.cover_url} alt={post.cover_alt||''} loading="eager" width="1600" height="1000" />}
      {toc.length>2&&<nav class="toc toc-inline" aria-label={T.toc}><p class="label plain">{T.toc}</p><ol>{toc.map(h=><li><a href={`#${h.id}`}>{h.text}</a></li>)}</ol></nav>}
      <div class="prose" set:html={html} />
      <aside class="article-cta-box" aria-label={T.ctaLabel}>
        <span class="solution-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={cat.icon} /></span>
        <div><h2>{cta[0]}</h2><p>{cta[1]}</p></div>
        <div class="cta-row"><a class="btn btn-primary" href={cta[2]}>{cta[2].includes('devis')?T.quote:T.aboutLink} <span aria-hidden="true">→</span></a><a class="btn btn-ghost" href="tel:+33787896760">{T.phone}</a></div>
      </aside>
      <aside class="author-box"><p class="label plain">{T.about}</p><p>{T.aboutText}</p><a class="text-link" href={en?'/en/#solutions':'/#solutions'}>{T.aboutLink} <span aria-hidden="true">→</span></a></aside>
    </article>
    {toc.length>2&&<aside class="toc toc-side" aria-label={T.toc}><p class="label plain">{T.toc}</p><ol>{toc.map(h=><li><a href={`#${h.id}`}>{h.text}</a></li>)}</ol><a class="btn btn-primary btn-sm" href={cta[2].includes('devis')?cta[2]:(en?'/en/devis/':'/devis/')}>{T.quote}</a></aside>}
  </div>
  {related.length>0&&<section class="section related-guides"><div class="section-head"><div><p class="label">{T.related}</p></div><a class="text-link" href={`${base}/`}>{T.more} <span aria-hidden="true">→</span></a></div><div class="cards">{related.map(p=><a class="card" href={`${base}/${p.slug}/`}><span class="chip">{catByName(p.category)[lang]}</span><h3>{p.title}</h3><span class="card-cta">{T.read} <span aria-hidden="true">→</span></span></a>)}</div></section>}
</Layout>
<script>
  // Highlight the current section in the side table of contents.
  const links=[...document.querySelectorAll<HTMLAnchorElement>('.toc-side a[href^="#"]')];
  if(links.length&&'IntersectionObserver' in window){
    const map=new Map(links.map(a=>[a.getAttribute('href')!.slice(1),a]));
    const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){links.forEach(l=>l.removeAttribute('aria-current'));map.get(e.target.id)?.setAttribute('aria-current','true');}}),{rootMargin:'-20% 0px -70% 0px'});
    document.querySelectorAll('.prose h2[id]').forEach(h=>io.observe(h));
  }
</script>
