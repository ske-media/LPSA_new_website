---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import CupStory from '../components/CupStory.astro';
import ParkEstimator from '../components/ParkEstimator';
import {editorialPosts} from '../lib/editorial';
const featured=['lavage-gobelets-festival','combien-gobelets-prevoir-evenement','gobelets-marche-noel-vin-chaud'].map(slug=>editorialPosts.find(p=>p.slug===slug)!);
const icons={
  lavage:'<path d="M12 3c3 4 5 6.5 5 9a5 5 0 0 1-10 0c0-2.5 2-5 5-9z"/><path d="M9.5 13.5a2.5 2.5 0 0 0 2.5 2.5"/>',
  gobelets:'<path d="M6 4h12l-1.6 15.2a1 1 0 0 1-1 .8H8.6a1 1 0 0 1-1-.8z"/><path d="M6.6 9h10.8"/>',
  vaisselle:'<circle cx="12" cy="12" r="6.5"/><circle cx="12" cy="12" r="3"/><path d="M3 4v6a1.5 1.5 0 0 0 1.5 1.5V20M21 4c-1.5 1-2 3-2 5s.8 2.5 2 2.5V20"/>',
};
const solutions=[
  {key:'lavage',n:'01',title:'Lavage de gobelets',lead:'Vous avez les gobelets.',text:'Nous prenons le relais pour le lavage, le séchage, le comptage et le conditionnement.',points:['Dès 3 000 gobelets par événement','Collecte et livraison possibles'],href:'/prestations/lavage-gobelets/',cta:'Organiser mon lavage'},
  {key:'gobelets',n:'02',title:'Location de gobelets',lead:'Il vous manque un parc.',text:'Louez des gobelets adaptés à vos boissons et à vos volumes. Le lavage est prévu dans l’organisation.',points:['Formats et quantités sur mesure','Retour au lavage organisé'],href:'/prestations/location-gobelets/',cta:'Louer des gobelets'},
  {key:'vaisselle',n:'03',title:'Location de vaisselle',lead:'Il y a aussi les repas.',text:'Plastique réutilisable, porcelaine, inox et verrerie : préparez la vaisselle et son lavage ensemble.',points:['Location et lavage réunis','Dès 1 500 € de commande'],href:'/prestations/location-vaisselle/',cta:'Équiper mon événement'},
];
const stats=[{v:3000,suffix:'',unit:'gobelets',text:'minimum par événement pour le lavage'},{v:4,suffix:'',unit:'étapes',text:'lavage, séchage, comptage, conditionnement'},{v:3,suffix:'',unit:'départements',text:'Haute-Savoie, Savoie et Ain'},{v:100000,suffix:'+',unit:'gobelets',text:'au-delà, nous étudions les projets plus lointains'}];
const steps=[{n:'01',title:'On prépare ensemble.',text:'Vos dates, vos volumes, vos formats. Nous définissons le calendrier et les modalités de transport.'},{n:'02',title:'On prend le relais.',text:'Collecte organisée si vous le souhaitez, puis lavage, séchage, comptage et conditionnement.'},{n:'03',title:'Votre parc repart.',text:'Retrait ou livraison selon le calendrier convenu. Prêt pour le prochain rendez-vous.'}];
const faq=[
  {q:'À partir de quel volume intervenez-vous ?',a:'Le lavage est proposé dès 3 000 gobelets par événement. Pour un programme récurrent, présentez-nous votre calendrier et votre volume annuel.'},
  {q:'Vous organisez aussi le transport ?',a:'Oui. Nous organisons la collecte et la livraison avec nos partenaires de transport. Le service est chiffré séparément dans votre proposition.'},
  {q:'Et si nous n’avons pas de gobelets ?',a:'Nous pouvons préparer une location ou vous accompagner dans le choix d’un parc à acheter.'},
  {q:'Intervenez-vous au-delà des Savoies et de l’Ain ?',a:'Pour les marchés de plus de 100 000 gobelets, nous étudions les possibilités au-delà du 74, du 73 et du 01, selon le calendrier et la logistique.'},
  {q:'Qu’est-ce qu’une entreprise adaptée ?',a:'C’est une entreprise qui emploie majoritairement des personnes en situation de handicap. Confier votre prestation à La Plonge s’Adapte soutient directement ces emplois, et peut, sous conditions, entrer dans votre démarche OETH.'},
];
const faqLd={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Layout title="Lavage et location de gobelets en Savoie et Haute-Savoie | La Plonge s’Adapte">
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <!-- Act 1 · La plongée -->
  <section class="dive" id="plongee" data-dive aria-label="La Plonge s’Adapte">
    <div class="dive-stage">
      <canvas class="dive-canvas" aria-hidden="true"></canvas>
      <div class="dive-poster" aria-hidden="true"><Logo id="lg-hero" variant="mark" /></div>
      <div class="dive-copy dive-copy-1">
        <p class="label">Lavage & location de gobelets · Dès 3 000 pièces</p>
        <h1>Le public est parti. <em>Les gobelets restent.</em></h1>
        <p class="lead">Vous créez les souvenirs. Nous prenons la suite : lavage, location et logistique pour vos grands événements en Haute-Savoie, Savoie et Ain.</p>
        <div class="cta-row"><a class="btn btn-primary btn-lg" href="/devis/">Préparer mon événement <span aria-hidden="true">→</span></a><a class="btn btn-ghost btn-lg" href="#solutions">Voir les prestations</a></div>
      </div>
      <div class="dive-copy dive-copy-2">
        <p class="label">Sous la surface</p>
        <h2>Ici, la plonge <em>se fait en grand.</em></h2>
        <p class="lead">Des milliers de gobelets lavés, séchés, comptés et reconditionnés par l’équipe d’une entreprise adaptée, à Neydens.</p>
      </div>
      <div class="depth" aria-hidden="true"><span class="depth-value">0 m</span><div class="depth-track"><i></i></div><span class="depth-label">Profondeur</span></div>
      <a class="dive-cue" href="#cup-story"><span>Plongez</span><i aria-hidden="true"></i></a>
    </div>
  </section>

  <!-- Act 2 · Le lendemain -->
  <CupStory />

  <!-- Repères -->
  <section class="stats wrap" aria-label="Repères">
    {stats.map((s,i)=><div class="stat" data-reveal style={`--d:${i*.08}s`}><p class="stat-value"><span data-count={s.v}>{s.v.toLocaleString('fr-FR')}</span>{s.suffix}</p><p class="stat-unit">{s.unit}</p><p class="stat-text">{s.text}</p></div>)}
  </section>

  <!-- Méthode -->
  <section id="methode" class="section method" data-method>
    <div class="method-head" data-reveal>
      <p class="label">Le passage de relais</p>
      <h2>Vous faites l’événement. <em>On s’occupe de la suite.</em></h2>
      <p class="lead">Le lavage ne devrait pas être la dernière épreuve de votre équipe. Une organisation claire, du premier échange au prochain service.</p>
      <a class="btn btn-ghost" href="/devis/">Commencer par un premier échange <span aria-hidden="true">→</span></a>
    </div>
    <ol class="method-steps">
      <i class="method-line" aria-hidden="true"><b></b></i>
      {steps.map((s,i)=><li data-reveal style={`--d:${i*.1}s`}><span class="method-n">{s.n}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>)}
    </ol>
  </section>

  <!-- Prestations -->
  <section id="solutions" class="section solutions">
    <div class="section-head" data-reveal><div><p class="label">À chaque besoin, sa solution</p><h2>Les gobelets au centre. <em>Tout votre événement autour.</em></h2></div><p>Un événement, plusieurs dates ou toute une saison : construisons la bonne prise en charge.</p></div>
    <div class="cards solution-grid">
      {solutions.map((s,i)=><a class="card solution" href={s.href} data-reveal data-spot style={`--d:${i*.1}s`}>
        <span class="solution-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.key as keyof typeof icons]} /></span>
        <span class="card-number">{s.n}</span>
        <h3>{s.title}</h3><p class="solution-lead">{s.lead}</p><p>{s.text}</p>
        <ul>{s.points.map(p=><li>{p}</li>)}</ul>
        <span class="card-cta">{s.cta} <span aria-hidden="true">→</span></span>
      </a>)}
    </div>
    <div class="solutions-more" data-reveal><p>Vous souhaitez <strong>acheter</strong> ou <strong>stocker</strong> votre parc ?</p><div class="cta-row"><a class="btn btn-ghost btn-sm" href="/devis/?besoin=conseil">Conseil à l’achat</a><a class="btn btn-ghost btn-sm" href="/devis/?besoin=stockage">Stockage de parc</a></div></div>
  </section>

  <!-- Estimateur -->
  <section id="estimer" class="section estimate">
    <div class="section-head" data-reveal><div><p class="label">L’estimateur de parc</p><h2>Combien de gobelets <em>prévoir ?</em></h2></div><p>Trois chiffres suffisent pour une première estimation, avec la méthode de notre guide. Ajustez les curseurs.</p></div>
    <div data-reveal><ParkEstimator client:visible /></div>
  </section>

  <!-- Engagement -->
  <section class="engage">
    <div class="engage-glow" aria-hidden="true"><Logo id="lg-engage" variant="mark" /></div>
    <div class="wrap engage-inner">
      <div data-reveal><p class="label">Un partenaire local. Un engagement concret.</p><h2>Du soin pour vos gobelets. <em>Une place pour chacun.</em></h2></div>
      <div class="engage-text" data-reveal style="--d:.1s">
        <p class="lead">La Plonge s’Adapte est une entreprise adaptée à Neydens. Votre prestation fait travailler une équipe et soutient l’emploi de personnes en situation de handicap.</p>
        <p>Une activité utile à vos événements. Un engagement qui se construit dans le travail de chaque jour.</p>
        <div class="engage-links">
          <a class="card engage-card" href="/rse/" data-spot><span class="label plain">Calculateur RSE</span><strong>Votre scénario de réemploi</strong><span class="card-cta">Explorer <span aria-hidden="true">→</span></span></a>
          <a class="card engage-card" href="/entreprise-adaptee/oeth/" data-spot><span class="label plain">OETH · AGEFIPH</span><strong>Comprendre la déduction possible</strong><span class="card-cta">Lire <span aria-hidden="true">→</span></span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Guides -->
  <section class="section guides">
    <div class="section-head" data-reveal><div><p class="label">Les repères avant le premier devis</p><h2>Un événement bien préparé. <em>Jusqu’au dernier gobelet.</em></h2></div><a class="text-link" href="/blog/">Tous les guides <span aria-hidden="true">→</span></a></div>
    <div class="cards guide-row">
      {featured.map((p,i)=><a class="card guide" href={`/blog/${p.slug}/`} data-reveal data-spot style={`--d:${i*.1}s`}><span class="chip">{p.category}</span><h3>{p.title}</h3><p>{p.excerpt}</p><span class="card-cta">Lire le guide <span aria-hidden="true">→</span></span></a>)}
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq">
    <div class="faq-head" data-reveal><p class="label">Les questions qu’on nous pose</p><h2>Avant de passer <em>le relais.</em></h2><p class="lead">Une autre question ? Appelez-nous au <a class="text-link" href="tel:+33787896760">07 87 89 67 60</a>.</p></div>
    <div class="faq-list">{faq.map((f,i)=><details data-reveal style={`--d:${i*.05}s`}><summary><span>{f.q}</span><i aria-hidden="true"></i></summary><p>{f.a}</p></details>)}</div>
  </section>

  <!-- Final -->
  <section class="final">
    <div class="final-mark" aria-hidden="true"><Logo id="lg-final" variant="mark" /></div>
    <div class="final-inner" data-reveal>
      <p class="label plain">Le prochain événement se prépare maintenant</p>
      <h2>Moins de pyramides. <em>Plus de perspectives.</em></h2>
      <p class="lead">Quelques informations suffisent pour commencer. Notre équipe revient vers vous pour préparer la suite.</p>
      <div class="cta-row"><a class="btn btn-primary btn-lg" href="/devis/">Préparer mon événement <span aria-hidden="true">→</span></a><a class="btn btn-ghost btn-lg" href="tel:+33787896760">07 87 89 67 60</a></div>
    </div>
  </section>
</Layout>
<script>
  const root=document.querySelector<HTMLElement>('[data-dive]');
  const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Depth gauge and copy follow scroll even before (or without) WebGL.
  if(root){
    const value=root.querySelector('.depth-value');
    const onScroll=()=>{const r=root.getBoundingClientRect(),p=Math.max(0,Math.min(1,-r.top/Math.max(1,r.height-innerHeight)));root.style.setProperty('--p',p.toFixed(4));if(value)value.textContent=`${Math.round(p*40)} m`;};
    addEventListener('scroll',onScroll,{passive:true});onScroll();
    if(reduced)root.dataset.scene='static';
    else{
      const load=()=>import('../lib/dive-scene').then(m=>m.mountDive(root)).catch(()=>{root.dataset.scene='static';});
      'requestIdleCallback' in window?requestIdleCallback(load,{timeout:1200}):setTimeout(load,300);
    }
  }
  // Method line follows scroll
  const method=document.querySelector<HTMLElement>('[data-method]');
  if(method){const upd=()=>{const r=method.getBoundingClientRect(),p=Math.max(0,Math.min(1,(innerHeight*.7-r.top)/r.height));method.style.setProperty('--m',p.toFixed(3));};addEventListener('scroll',upd,{passive:true});upd();}
  // Spotlight on cards
  document.querySelectorAll<HTMLElement>('[data-spot]').forEach(el=>el.addEventListener('pointermove',e=>{const r=el.getBoundingClientRect();el.style.setProperty('--mx',`${e.clientX-r.left}px`);el.style.setProperty('--my',`${e.clientY-r.top}px`);}));
  // Count-up
  const counters=document.querySelectorAll<HTMLElement>('[data-count]');
  if(!reduced&&'IntersectionObserver' in window){
    const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;io.unobserve(e.target);const el=e.target as HTMLElement,end=Number(el.dataset.count),t0=performance.now();
      const tick=(t:number)=>{const k=Math.min(1,(t-t0)/1400),v=Math.round(end*(1-Math.pow(1-k,3)));el.textContent=v.toLocaleString('fr-FR');if(k<1)requestAnimationFrame(tick);};requestAnimationFrame(tick);}),{threshold:.6});
    counters.forEach(c=>io.observe(c));
  }
</script>
