---
import Layout from '../layouts/Layout.astro';
import CupStory from '../components/CupStory.astro';
import {editorialPosts} from '../lib/editorial';
const featured=['lavage-gobelets-festival','combien-gobelets-prevoir-evenement','gobelets-marche-noel-vin-chaud'].map(slug=>editorialPosts.find(p=>p.slug===slug)!);
const solutions=[{n:'01',title:'Vous avez les gobelets.',text:'Nous prenons le relais pour le lavage, le séchage, le comptage et le conditionnement.',cta:'Organiser mon lavage',need:'lavage'},{n:'02',title:'Il vous manque un parc.',text:'Louez des gobelets adaptés à vos boissons et à vos volumes. Le lavage est prévu dans l’organisation.',cta:'Louer des gobelets',need:'gobelets'},{n:'03',title:'Il y a aussi les repas.',text:'Plastique réutilisable, porcelaine, inox et verrerie : préparez la vaisselle et son lavage ensemble.',cta:'Équiper mon événement',need:'vaisselle'}];
---
<Layout title="Lavage et location de gobelets en Savoie et Haute-Savoie | La Plonge s’Adapte">
  <CupStory />
  <div class="trust-strip"><span>Pour les événements qui voient grand.</span><p>Festivals <i>✳</i> Marchés de Noël <i>✳</i> Événements sportifs <i>✳</i> Collectivités</p></div>
  <section id="methode" class="section method">
    <div><p class="eyebrow">LE PASSAGE DE RELAIS</p><h2>Vous faites l’événement.<br /><em>On s’occupe de la suite.</em></h2><p class="section-intro">Le lavage ne devrait pas être la dernière épreuve de votre équipe. Une organisation claire, du premier échange au prochain service.</p></div>
    <ol class="steps"><li><span>01</span><div><h3>On prépare ensemble.</h3><p>Vos dates, vos volumes, vos formats. Nous définissons le calendrier et les modalités de transport.</p></div></li><li><span>02</span><div><h3>On prend le relais.</h3><p>Collecte organisée si vous le souhaitez, lavage, séchage, comptage et conditionnement.</p></div></li><li><span>03</span><div><h3>Votre parc repart.</h3><p>Retrait ou livraison selon le calendrier convenu. Prêt pour le prochain rendez-vous.</p></div></li></ol>
  </section>
  <section id="solutions" class="section solutions"><p class="eyebrow">À CHAQUE BESOIN, SA SOLUTION</p><div class="section-heading"><h2>Les gobelets au centre.<br /><em>Tout votre événement autour.</em></h2><p>Un événement, plusieurs dates ou toute une saison : construisons la bonne prise en charge.</p></div><div class="cards">{solutions.map(s=><a class="solution-card" href={`/prestations/${s.need==="lavage"?"lavage-gobelets":s.need==="gobelets"?"location-gobelets":"location-vaisselle"}/`}><span class="card-number">{s.n} /</span><h3>{s.title}</h3><p>{s.text}</p><span class="card-cta">{s.cta} <span aria-hidden="true">↗</span></span></a>)}</div><div class="secondary-services"><p>Vous souhaitez acheter ou stocker votre parc ?</p><a href="/devis/?besoin=conseil">Parlons de votre projet <span aria-hidden="true">↗</span></a></div></section>
  <section class="section impact"><div><p class="eyebrow">UN PARTENAIRE LOCAL. UN ENGAGEMENT CONCRET.</p><h2>Du soin pour vos gobelets.<br /><em>Une place pour chacun.</em></h2></div><div><p>La Plonge s’Adapte est une entreprise adaptée à Neydens. Votre prestation fait travailler une équipe et soutient l’emploi de personnes en situation de handicap.</p><p>Une activité utile à vos événements. Un engagement qui se construit dans le travail de chaque jour.</p><a class="rse-home-link" href="/rse/">Explorer le calculateur RSE ↗</a><br /><a class="rse-home-link" href="/entreprise-adaptee/oeth/">Comprendre le dispositif OETH / AGEFIPH ↗</a></div></section>
  <section class="section featured-guides"><p class="eyebrow">LES REPÈRES AVANT LE PREMIER DEVIS</p><div class="section-heading"><h2>Un événement bien préparé.<br /><em>Jusqu’au dernier gobelet.</em></h2><a class="text-link" href="/blog/">Tous les guides ↗</a></div><div class="cards">{featured.map(p=><a class="solution-card" href={`/blog/${p.slug}/`}><span class="eyebrow">{p.category}</span><h3>{p.title}</h3><p>{p.excerpt}</p><span class="card-cta">Lire le guide ↗</span></a>)}</div></section>
  <section class="section faq"><p class="eyebrow">LES QUESTIONS QU’ON NOUS POSE</p><h2>Avant de passer le relais.</h2><details><summary>À partir de quel volume intervenez-vous ?</summary><p>Le lavage est proposé dès 3 000 gobelets par événement. Pour un programme récurrent, présentez-nous votre calendrier et votre volume annuel.</p></details><details><summary>Vous organisez aussi le transport ?</summary><p>Oui. Nous organisons la collecte et la livraison avec nos partenaires de transport. Le service est chiffré séparément dans votre proposition.</p></details><details><summary>Et si nous n’avons pas de gobelets ?</summary><p>Nous pouvons préparer une location ou vous accompagner dans le choix d’un parc à acheter.</p></details><details><summary>Intervenez-vous au-delà des Savoies et de l’Ain ?</summary><p>Pour les marchés de plus de 100 000 gobelets, nous étudions les possibilités au-delà du 74, du 73 et du 01, selon le calendrier et la logistique.</p></details></section>
  <section class="final-cta"><p class="eyebrow">LE PROCHAIN ÉVÉNEMENT SE PRÉPARE MAINTENANT</p><h2>Moins de pyramides.<br /><em>Plus de perspectives.</em></h2><a class="button light" href="/devis/">Parlons de votre événement <span aria-hidden="true">↗</span></a><p>Quelques informations suffisent pour commencer.</p></section>
</Layout>
