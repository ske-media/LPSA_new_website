---
import Layout from '../../layouts/Layout.astro';
import Logo from '../../components/Logo.astro';
import {personas} from '../../data/personas';
import {editorialPosts} from '../../lib/editorial';
export function getStaticPaths(){return personas.map(p=>({params:{persona:p.slug},props:{p}}));}
const {p}=Astro.props;
const quote=`/devis/?besoin=${p.besoin}&profil=${p.slug}`;
const guides=p.guides.map(slug=>editorialPosts.find(g=>g.slug===slug)!).filter(Boolean);
const others=personas.filter(o=>o.slug!==p.slug);
const url=`https://laplongesadapte.com/pour/${p.slug}/`;
const ld=[
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Accueil',item:'https://laplongesadapte.com/'},{'@type':'ListItem',position:2,name:p.nav,item:url}]},
  {'@context':'https://schema.org','@type':'Service',name:p.title.split(' | ')[0],description:p.description,url,audience:{'@type':'Audience',audienceType:p.nav},provider:{'@type':'LocalBusiness',name:'La Plonge s’Adapte',telephone:'+33787896760',url:'https://laplongesadapte.com/'},areaServed:['Haute-Savoie','Savoie','Ain']},
  {'@context':'https://schema.org','@type':'FAQPage',mainEntity:p.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))},
];
---
<Layout title={p.title} description={p.description}>
  {ld.map(x=><script type="application/ld+json" set:html={JSON.stringify(x)} />)}
  <section class="page-hero persona-hero">
    <div class="hero-mark" aria-hidden="true"><Logo id="lg-pour" variant="mark" /></div>
    <p class="crumb"><a href="/">Accueil</a> / <a href="/#pour-qui">Pour qui ?</a> / <span>{p.nav}</span></p>
    <p class="label">{p.label}</p>
    <h1>{p.h1[0]} <em>{p.h1[1]}</em></h1>
    <p class="lead">{p.lead}</p>
    <div class="cta-row"><a class="btn btn-primary btn-lg" href={quote}>Demander un devis <span aria-hidden="true">→</span></a><a class="btn btn-ghost btn-lg" href="tel:+33787896760">07 87 89 67 60</a></div>
    <div class="persona-orb" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={p.icon} /></div>
  </section>

  <section class="section pains">
    <div class="section-head" data-reveal><div><p class="label">Votre réalité</p><h2>On connaît <em>vos lendemains.</em></h2></div></div>
    <div class="cards">{p.pains.map((x,i)=><div class="card pain" data-reveal style={`--d:${i*.08}s`}><span class="card-number">{String(i+1).padStart(2,'0')}</span><h3>{x.title}</h3><p>{x.text}</p></div>)}</div>
  </section>

  <section class="section args" style="padding-top:0">
    <div class="section-head" data-reveal><div><p class="label">Nos réponses</p><h2>{p.argsTitle[0]} <em>{p.argsTitle[1]}</em></h2></div><a class="btn btn-ghost" href={quote}>Parler de mon besoin <span aria-hidden="true">→</span></a></div>
    <ul class="arg-grid">{p.args.map((x,i)=><li data-reveal style={`--d:${(i%3)*.08}s`}><span class="arg-check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><h3>{x.title}</h3><p>{x.text}</p></li>)}</ul>
  </section>

  <section class="section split" style="padding-top:0">
    <div data-reveal><p class="label">Comment ça se passe</p><h2>Trois étapes, <em>un seul interlocuteur.</em></h2><ol class="feature-list" style="margin-top:32px">{p.steps.map(([h,t],i)=><li><b>{String(i+1).padStart(2,'0')}</b><div><h3>{h}</h3><p>{t}</p></div></li>)}</ol></div>
    <div data-reveal style="--d:.1s"><p class="label">Les prestations utiles</p><div class="service-links">{p.services.map(s=><a class="card service-link" href={s.href}><h3>{s.title}</h3><p>{s.text}</p><span class="card-cta">Découvrir <span aria-hidden="true">→</span></span></a>)}</div></div>
  </section>

  <section class="engage persona-engage">
    <div class="wrap engage-inner">
      <div data-reveal><p class="label">Entreprise adaptée · Neydens, Haute-Savoie</p><h2>{p.engage.title[0]} <em>{p.engage.title[1]}</em></h2></div>
      <div class="engage-text" data-reveal style="--d:.1s"><p class="lead">{p.engage.text}</p><div class="engage-linklist">{p.engage.links.map(l=><a class="text-link" href={l.href}>{l.label} <span aria-hidden="true">→</span></a>)}</div></div>
    </div>
  </section>

  <section class="section faq">
    <div class="faq-head" data-reveal><p class="label">Questions fréquentes</p><h2>Vos questions, <em>nos réponses.</em></h2><p class="lead">Une autre question ? <a class="text-link" href="tel:+33787896760">07 87 89 67 60</a></p></div>
    <div class="faq-list">{p.faq.map((f,i)=><details data-reveal style={`--d:${i*.05}s`}><summary><span>{f.q}</span><i aria-hidden="true"></i></summary><p>{f.a}</p></details>)}</div>
  </section>

  <section class="section" style="padding-top:0"><div class="band-cta" data-reveal><h2>{p.cta[0]} <em>{p.cta[1]}</em></h2><div class="cta-row"><a class="btn btn-primary btn-lg" href={quote}>Demander un devis <span aria-hidden="true">→</span></a><a class="btn btn-ghost btn-lg" href="tel:+33787896760">07 87 89 67 60</a></div></div></section>

  <section class="section related-guides" style="padding-top:0"><p class="label">Les guides utiles</p><div class="cards">{guides.map((g,i)=><a class="card" href={`/blog/${g.slug}/`} data-reveal style={`--d:${i*.08}s`}><span class="chip">{g.category}</span><h3>{g.title}</h3><span class="card-cta">Lire le guide <span aria-hidden="true">→</span></span></a>)}</div></section>

  <nav class="section other-personas" style="padding-top:0" aria-label="Autres profils"><p class="label">Nous accompagnons aussi</p><div class="persona-chips">{others.map(o=><a href={`/pour/${o.slug}/`}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={o.icon} />{o.nav}</a>)}</div></nav>
</Layout>
