---
import Layout from '../../layouts/Layout.astro';
import Article from '../../views/Article.astro';
import type {Post} from '../../lib/blog';
import {getPublicPost,listPosts} from '../../lib/blog-server';
import {editorialPostsEn} from '../../lib/editorial-en';
export const prerender=false;
let post:Post|null=null,error=false;try{post=await getPublicPost(Astro.params.slug!);}catch{error=true;}
if(!post)Astro.response.status=error?503:404;
Astro.response.headers.set('Cache-Control','public, max-age=0, s-maxage=600');
let related:Post[]=[];
if(post){try{const all=(await listPosts(true)).filter(p=>p.slug!==post!.slug);related=[...all.filter(p=>p.category===post!.category),...all.filter(p=>p.category!==post!.category)].slice(0,3);}catch{/* The article stays readable if recommendations fail. */}}
const twin=post&&editorialPostsEn.some(p=>p.slug===post!.slug)?`/en/blog/${post.slug}/`:null;
---
{post?<Article lang="fr" post={post} related={related} alternate={twin} />:<Layout title="Article indisponible | La Plonge s’Adapte" privatePage><section class="legal"><h1>{error?'Article temporairement indisponible.':'Cet article n’est pas disponible.'}</h1><a href="/blog/">Revenir aux guides</a></section></Layout>}
