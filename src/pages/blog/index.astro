---
import BlogList from '../../views/BlogList.astro';
import {listPosts} from '../../lib/blog-server';
import {catByName} from '../../lib/blog-structure';
import type {Post} from '../../lib/blog';
export const prerender=false;
// Old filter URLs (?categorie=Gobelets) move to the topic pages.
const legacy=Astro.url.searchParams.get('categorie');
if(legacy)return Astro.redirect(`/blog/categorie/${catByName(legacy).slug}/`,301);
let posts:Post[]=[],unavailable=false;try{posts=await listPosts(true);}catch{unavailable=true;Astro.response.status=503;}
Astro.response.headers.set('Cache-Control','public, max-age=0, s-maxage=600');
---
<BlogList lang="fr" posts={posts} unavailable={unavailable} alternate="/en/blog/" />
