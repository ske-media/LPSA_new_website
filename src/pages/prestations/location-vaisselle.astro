---
import Layout from '../../layouts/Layout.astro';
import Logo from '../../components/Logo.astro';
import PartnerAugust from '../../components/PartnerAugust.astro';
import VaisselleCatalog from '../../components/VaisselleCatalog';
import items from '../../data/vaisselle-august.json';
import {editorialPosts} from '../../lib/editorial';
const guides=['location-vaisselle-evenement-guide','collecte-livraison-gobelets-evenement','rse-gobelets-reemploi-indicateurs'].map(slug=>editorialPosts.find(p=>p.slug===slug)!);
const mosaic=[3,40,75,100,120,150].map(i=>items[i%items.length]);
const occasions=[
  {title:'Mariage',text:'Une table digne du plus beau jour : porcelaine, verrerie fine et couverts dorés ou cuivrés.',icon:'<path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z"/>'},
  {title:'Banquet & gala',text:'Des centaines de couverts identiques, livrés comptés et prêts à dresser.',icon:'<path d="M4 20h16M6 20v-6M18 20v-6M3 14h18l-2-5H5z"/>'},
  {title:'Repas d’affaires & séminaire',text:'Une vaisselle sobre et soignée pour recevoir clients et équipes sans fausse note.',icon:'<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>'},
  {title:'Réception privée',text:'Anniversaire, baptême, fête de famille : la belle vaisselle, sans la vaisselle à faire.',icon:'<path d="M8 3h8l-1 7a3 3 0 0 1-6 0zM12 13v6M8 21h8"/>'},
  {title:'Cocktail & buffet',text:'Verrines, flûtes, plats et plateaux de service pour un buffet élégant.',icon:'<path d="M5 12h14a7 7 0 0 1-14 0zM3 12h18M9 5c0 1.5 1 1.5 1 3M14 5c0 1.5 1 1.5 1 3"/>'},
  {title:'Association & repas collectif',text:'Repas de village, assemblée, loto : une formule adaptée aux petits budgets.',icon:'<circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><path d="M2.5 20a5.5 5.5 0 0 1 11 0M10.5 20a5.5 5.5 0 0 1 11 0"/>',href:'/devis/?besoin=petits-lots'},
];
const steps=[
  ['Votre sélection','Composez votre table dans le catalogue ou décrivez votre réception : nous vous conseillons sur les quantités et les modèles.'],
  ['Livraison, prête à servir','Votre vaisselle arrive propre, comptée et conditionnée, à l’heure convenue, sur le lieu de votre réception.'],
  ['En lien avec votre traiteur','Si vous le souhaitez, nous nous coordonnons directement avec votre traiteur : horaires, quantités, points de dépose.'],
  ['Reprise après le service','Pas besoin de laver : nous reprenons la vaisselle sale, à l’heure qui arrange votre équipe.'],
  ['Lavage par notre équipe','Le lavage, c’est notre métier. Votre prestation fait travailler l’équipe de notre entreprise adaptée.'],
];
const faq=[
  {q:'Faut-il laver la vaisselle avant de la rendre ?',a:'Non. Le lavage fait partie de la prestation : vous nous rendez la vaisselle après le service, nous nous occupons du reste.'},
  {q:'Travaillez-vous avec mon traiteur ?',a:'Oui, si vous le souhaitez. Nous pouvons nous coordonner directement avec lui pour les horaires de livraison, les quantités et la reprise.'},
  {q:'Quel est le minimum de commande ?',a:'Pour la vaisselle, le minimum de commande est de 1 500 € pour la location et le lavage ; le transport est en supplément. Pour une association ou un petit événement, parlons-en : nous étudions une formule adaptée.'},
  {q:'Comment connaître les tarifs et disponibilités ?',a:'Composez votre sélection dans le catalogue puis demandez votre devis : nous vérifions les disponibilités pour vos dates et vous transmettons une proposition complète.'},
];
const ld={'@context':'https://schema.org','@type':'Service',name:'Location de vaisselle événementielle',serviceType:'Location et lavage de vaisselle',provider:{'@type':'LocalBusiness',name:'La Plonge s’Adapte',telephone:'+33787896760'},areaServed:['Haute-Savoie','Savoie','Ain'],description:'Location de vaisselle pour mariages, banquets, repas d’affaires et réceptions : livraison, coordination traiteur, reprise et lavage, en partenariat avec August Events.'};
---
<Layout title="Location de vaisselle pour mariages et réceptions | Haute-Savoie" description="Mariages, banquets, repas d’affaires : vaisselle livrée prête à servir, reprise et lavée, en lien avec votre traiteur. Haute-Savoie, Savoie et Ain." hideQuoteButton>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))})} />
  <section class="page-hero vaisselle-hero">
    <div class="vaisselle-mosaic">{mosaic.map((m,i)=><img src={m.image} alt={`${m.name} en location`} width="420" height="420" style={`--i:${i}`} loading={i<3?'eager':'lazy'} />)}</div>
    <p class="crumb"><a href="/">Accueil</a> / <a href="/#solutions">Prestations</a> / <span>Location de vaisselle</span></p>
    <p class="label">Location de vaisselle · Réceptions</p>
    <h1>Du premier verre <em>au dernier couvert.</em></h1>
    <p class="lead">Mariages, banquets, repas d’affaires : une vaisselle élégante, livrée prête à servir, reprise et lavée par nos soins. Avec le catalogue de notre partenaire August Events.</p>
    <div class="cta-row"><a class="btn btn-primary btn-lg" href="#catalogue">Composer ma table <span aria-hidden="true">→</span></a><a class="btn btn-ghost btn-lg" href="/devis/?besoin=vaisselle">Demander un devis</a></div>
    <ul class="hero-facts"><li><strong>{items.length}</strong> références</li><li><strong>0</strong> vaisselle à faire</li><li><strong>1</strong> interlocuteur</li></ul>
  </section>

  <section class="section occasions">
    <div class="section-head" data-reveal><div><p class="label">Pour chaque réception</p><h2>La table que mérite <em>votre événement.</em></h2></div><p>De la réception intime au banquet de plusieurs centaines de couverts.</p></div>
    <div class="occasion-grid">{occasions.map((o,i)=><a class="card occasion" href={o.href||'/devis/?besoin=vaisselle'} data-reveal data-spot style={`--d:${(i%3)*.08}s`}><span class="solution-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={o.icon} /></span><h3>{o.title}</h3><p>{o.text}</p><span class="card-cta">Préparer ma réception <span aria-hidden="true">→</span></span></a>)}</div>
  </section>

  <section class="section split service-all">
    <div data-reveal><p class="label">Service tout compris</p><h2>Vous recevez. <em>On s’occupe de tout le reste.</em></h2><p class="lead" style="margin-top:22px">Livraison, mise à disposition, reprise, lavage : un seul interlocuteur, et une coordination directe avec votre traiteur si nécessaire.</p><div class="cta-row"><a class="btn btn-primary" href="/devis/?besoin=vaisselle">Demander un devis <span aria-hidden="true">→</span></a></div></div>
    <ol class="feature-list">{steps.map(([h,t],i)=><li data-reveal style={`--d:${i*.06}s`}><b>{String(i+1).padStart(2,'0')}</b><div><h3>{h}</h3><p>{t}</p></div></li>)}</ol>
  </section>

  <div class="wrap"><PartnerAugust id="pa-page" /></div>

  <section class="section catalog-section" id="catalogue">
    <div class="section-head" data-reveal><div><p class="label">Le catalogue</p><h2>Composez <em>votre table.</em></h2></div><p>Ajoutez les articles et quantités souhaités : votre sélection arrive directement dans votre demande de devis.</p></div>
    <VaisselleCatalog client:visible />
  </section>

  <section class="section faq">
    <div class="faq-head" data-reveal><p class="label">Questions fréquentes</p><h2>Avant de <em>dresser la table.</em></h2><p class="lead">Une autre question ? <a class="text-link" href="tel:+33787896760">07 87 89 67 60</a></p></div>
    <div class="faq-list">{faq.map((f,i)=><details data-reveal style={`--d:${i*.05}s`}><summary><span>{f.q}</span><i aria-hidden="true"></i></summary><p>{f.a}</p></details>)}</div>
  </section>

  <section class="section" style="padding-top:0"><div class="band-cta" data-reveal><h2>Votre réception mérite <em>une belle table.</em></h2><div class="cta-row"><a class="btn btn-primary btn-lg" href="/devis/?besoin=vaisselle">Demander un devis <span aria-hidden="true">→</span></a><a class="btn btn-ghost btn-lg" href="tel:+33787896760">07 87 89 67 60</a></div></div></section>

  <section class="section related-guides" style="padding-top:0"><p class="label">Pour préparer votre réception</p><div class="cards">{guides.map((p,i)=><a class="card" href={`/blog/${p.slug}/`} data-reveal style={`--d:${i*.08}s`}><span class="chip">{p.category}</span><h3>{p.title}</h3><span class="card-cta">Lire le guide <span aria-hidden="true">→</span></span></a>)}</div></section>
</Layout>
<script>
  document.querySelectorAll<HTMLElement>('[data-spot]').forEach(el=>el.addEventListener('pointermove',e=>{const r=el.getBoundingClientRect();el.style.setProperty('--mx',`${e.clientX-r.left}px`);el.style.setProperty('--my',`${e.clientY-r.top}px`);}));
</script>
