---
import Layout from '../../layouts/Layout.astro';
import Logo from '../../components/Logo.astro';
import {editorialPosts} from '../../lib/editorial';
import {personas} from '../../data/personas';
export function getStaticPaths(){return ['lavage-gobelets','location-gobelets'].map(service=>({params:{service}}));}
const entries={
'lavage-gobelets': ['Lavage de gobelets réutilisables','Vos gobelets propres. Une charge en moins.','Lavage, séchage, comptage et conditionnement de vos gobelets, quel que soit le nombre. Préparons vos dates, vos volumes et vos retours.','lavage'],
'location-gobelets':['Location de gobelets réutilisables','Votre événement a soif. Votre parc est prêt.','Vous n’avez pas de parc ou souhaitez compléter le vôtre ? Organisons les formats, les quantités et leur retour au lavage, selon les disponibilités.','gobelets'],
'location-vaisselle':['Location de vaisselle événementielle','Du premier verre au dernier couvert.','Plastique réutilisable, inox, porcelaine et verrerie : réunissez la location et le lavage. Minimum de commande de 1 500 € pour la location et le lavage, transport en supplément.','vaisselle']
};
const relatedSlugs:Record<string,string[]>={'lavage-gobelets':['lavage-gobelets-festival','prix-lavage-gobelets','collecte-livraison-gobelets-evenement'],'location-gobelets':['combien-gobelets-prevoir-evenement','acheter-ou-louer-gobelets-reutilisables','parc-gobelets-mutualise-collectivite'],'location-vaisselle':['location-vaisselle-evenement-guide','collecte-livraison-gobelets-evenement','rse-gobelets-reemploi-indicateurs']};
const guides=relatedSlugs[Astro.params.service!].map(slug=>editorialPosts.find(p=>p.slug===slug)!);
const [title,headline,intro,need]=entries[Astro.params.service as keyof typeof entries];
const steps:Record<string,[string,string][]>={
  lavage:[['Vos dates et vos volumes','Nous préparons ensemble le calendrier, les formats et les modalités de retour.'],['Collecte si vous le souhaitez','La collecte et la livraison peuvent être organisées avec nos partenaires de transport.'],['Lavage, séchage, comptage','Vos gobelets sont lavés, séchés, comptés puis conditionnés.'],['Votre parc repart','Retrait ou livraison selon le calendrier convenu, prêt pour le prochain service.']],
  gobelets:[['Vos besoins','Formats, quantités, dates : nous étudions les disponibilités pour votre événement.'],['La mise à disposition','Les gobelets sont préparés selon le calendrier convenu.'],['Le retour au lavage','Après l’événement, le retour et le lavage sont prévus dans l’organisation.'],['La suite','Pour une saison ou plusieurs dates, nous construisons un calendrier de rotations.']],
  vaisselle:[['Votre service','Plastique réutilisable, inox, porcelaine ou verrerie : nous préparons la vaisselle adaptée à vos repas.'],['Location et lavage réunis','Une seule organisation pour la mise à disposition et le lavage.'],['Le transport','Collecte et livraison possibles, chiffrées en supplément.'],['Le minimum','Le minimum de commande est de 1 500 € pour la location et le lavage.']],
};
const meta:Record<string,{title:string;description:string;includes:[string,string][];faq:{q:string;a:string}[];audiences:string[]}>={
  lavage:{title:'Lavage de gobelets réutilisables | Haute-Savoie, Savoie, Ain',description:'Lavage, séchage, comptage et conditionnement de vos gobelets réutilisables, avec collecte et livraison possibles. Entreprise adaptée en Haute-Savoie.',
    includes:[['Lavage et séchage','Vos gobelets réutilisables sont lavés puis séchés, prêts à resservir.'],['Comptage','Chaque retour est compté : vous savez ce qui revient et ce qui manque.'],['Conditionnement','Les gobelets propres repartent conditionnés, faciles à stocker et à redistribuer.'],['Transport, si besoin','Collecte et livraison avec nos partenaires de transport, chiffrées séparément. Le dépôt et le retrait par vos soins sont possibles.'],['Stockage, si besoin','Nous pouvons garder votre parc entre deux événements.']],
    faq:[{q:'Lavez-vous les petits volumes ?',a:'Oui. Nous adaptons l’organisation à votre volume, avec une formule petits lots pour les associations et les petits événements.'},{q:'Organisez-vous la collecte et la livraison ?',a:'Oui, avec nos partenaires de transport. Ce service est chiffré séparément ; vous pouvez aussi déposer et récupérer vos gobelets vous-même.'},{q:'Dans quelle zone intervenez-vous ?',a:'En priorité en Haute-Savoie, Savoie et dans l’Ain. Pour un événement plus éloigné, nous étudions les possibilités selon le calendrier et la logistique.'},{q:'Saurez-vous combien de gobelets sont revenus ?',a:'Oui. Chaque retour est compté, ce qui vous permet de suivre les pertes et d’alimenter votre bilan.'},{q:'Pouvez-vous laver nos gobelets toute la saison ?',a:'Oui. Présentez-nous votre calendrier : nous préparons une organisation qui se répète, événement après événement.'}],
    audiences:['comites-des-fetes','clubs-sportifs','collectivites-mairies']},
  gobelets:{title:'Location de gobelets réutilisables | Haute-Savoie, Savoie, Ain',description:'Louez des gobelets réutilisables pour votre événement, avec leur retour au lavage organisé. Pour associations, clubs, entreprises et collectivités.',
    includes:[['Des gobelets réutilisables','Pour votre buvette, votre bar ou votre cocktail, sans investir dans un parc.'],['Des quantités adaptées','Nous étudions avec vous les formats et les quantités selon vos boissons et votre public.'],['Le lavage compris','Après l’événement, le retour et le lavage sont prévus dans l’organisation.'],['Transport, si besoin','Livraison et collecte possibles, chiffrées séparément, ou dépôt et retrait par vos soins.'],['Un conseil pour la suite','Vous hésitez entre louer et acheter ? Nous vous aidons à comparer.']],
    faq:[{q:'Faut-il laver les gobelets avant de les rendre ?',a:'Non. Le retour au lavage est prévu dans l’organisation : nous nous occupons du lavage après votre événement.'},{q:'Combien de gobelets prévoir ?',a:'Cela dépend du nombre de boissons servies et du rythme des retours. Notre estimateur en ligne donne une première estimation, que nous affinons ensemble.'},{q:'Vaut-il mieux louer ou acheter ?',a:'La location évite d’investir et de stocker ; l’achat se justifie si vous organisez plusieurs événements par an. Nous vous aidons à comparer, et nous lavons votre parc si vous achetez.'},{q:'Louez-vous aussi la vaisselle ?',a:'Oui : assiettes, couverts et verrerie, livrés prêts à servir puis repris et lavés, avec le catalogue de notre partenaire August Events.'}],
    audiences:['clubs-sportifs','comites-des-fetes','restaurants-entreprise']},
};
const m=meta[need];
const faqPage={'@context':'https://schema.org','@type':'FAQPage',mainEntity:m.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
const audiences=m.audiences.map(slug=>personas.find(x=>x.slug===slug)!);
const faqLd={'@context':'https://schema.org','@type':'Service',name:title,provider:{'@type':'LocalBusiness',name:'La Plonge s’Adapte',telephone:'+33787896760'},areaServed:['Haute-Savoie','Savoie','Ain'],description:intro};
---
<Layout title={m.title} description={m.description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqPage)} />
  <section class="page-hero">
    <div class="hero-mark" aria-hidden="true"><Logo id="lg-svc" variant="mark" /></div>
    <p class="crumb"><a href="/">Accueil</a> / <a href="/#solutions">Prestations</a> / <span>{title}</span></p>
    <p class="label">{title} · Haute-Savoie · Savoie · Ain</p>
    <h1>{headline}</h1>
    <p class="lead">{intro}</p>
    <div class="cta-row"><a class="btn btn-primary btn-lg" href={`/devis/?besoin=${need}`}>Préparer mon devis <span aria-hidden="true">→</span></a><a class="btn btn-ghost btn-lg" href="tel:+33787896760">07 87 89 67 60</a></div>
  </section>
  <section class="section split">
    <div data-reveal><p class="label">Comment ça se passe</p><h2>Un calendrier clair <em>avant de commencer.</em></h2><p class="lead" style="margin-top:22px">Un événement, plusieurs dates ou toute une saison : nous préparons une proposition adaptée à votre calendrier. Pour un événement plus éloigné, nous étudions les possibilités selon le calendrier et la logistique.</p><p class="small-lots-note">Association, fête de village, petit volume ? <a class="text-link" href="/devis/?besoin=petits-lots">Découvrez notre formule petits lots <span aria-hidden="true">→</span></a></p></div>
    <ol class="feature-list">{steps[need].map(([h,t],i)=><li data-reveal style={`--d:${i*.08}s`}><b>{String(i+1).padStart(2,'0')}</b><div><h3>{h}</h3><p>{t}</p></div></li>)}</ol>
  </section>
  <section class="section" style="padding-top:0">
    <div class="section-head" data-reveal><div><p class="label">Ce que comprend la prestation</p><h2>{title}, <em>sans rien oublier.</em></h2></div></div>
    <ul class="arg-grid">{m.includes.map(([h,t],i)=><li data-reveal style={`--d:${(i%3)*.08}s`}><span class="arg-check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><h3>{h}</h3><p>{t}</p></li>)}</ul>
  </section>
  <section class="section" style="padding-top:0"><p class="label">Pensé pour vous</p><div class="persona-chips">{audiences.map(o=><a href={`/pour/${o.slug}/`}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={o.icon} />{o.nav}</a>)}<a href="/prestations/location-vaisselle/"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="6.5"/><circle cx="12" cy="12" r="3"/></svg>Location de vaisselle</a></div></section>
  <section class="section faq" style="padding-top:0">
    <div class="faq-head" data-reveal><p class="label">Questions fréquentes</p><h2>Vos questions, <em>nos réponses.</em></h2><p class="lead">Une autre question ? <a class="text-link" href="tel:+33787896760">07 87 89 67 60</a></p></div>
    <div class="faq-list">{m.faq.map((f,i)=><details data-reveal style={`--d:${i*.05}s`}><summary><span>{f.q}</span><i aria-hidden="true"></i></summary><p>{f.a}</p></details>)}</div>
  </section>
  <section class="section" style="padding-top:0"><div class="band-cta" data-reveal><h2>Indiquez vos dates, <em>on s’occupe du reste.</em></h2><div class="cta-row"><a class="btn btn-primary btn-lg" href={`/devis/?besoin=${need}`}>Préparer mon devis <span aria-hidden="true">→</span></a></div></div></section>
  <section class="section related-guides" style="padding-top:0"><p class="label">Les guides pour préparer votre prestation</p><div class="cards">{guides.map((p,i)=><a class="card" href={`/blog/${p.slug}/`} data-reveal style={`--d:${i*.08}s`}><span class="chip">{p.category}</span><h3>{p.title}</h3><span class="card-cta">Lire le guide <span aria-hidden="true">→</span></span></a>)}</div></section>
</Layout>
